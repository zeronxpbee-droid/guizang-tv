# Real secrets must live outside this repository, for example under
# ~/LocalSecrets/MITV-UI/. Only non-sensitive *.example templates may be kept.
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.*
!*.env.example
!*.env.*.example
.envrc
.direnv/
secrets/
.secrets/
private/
.private/
*.token
*.secret
*.credentials
credentials*.json
client_secret*.json
service-account*.json
google-services.json

# Android signing keys, private keys, certificates and exported key stores.
*.jks
*.keystore
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.der
*.crt
*.cer
*.csr

# ADB and SSH authentication material must never enter the repository.
adbkey
adbkey.pub
*.adbkey
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub

# Raw diagnostics can contain local addresses, tokens and account data.
*.log
*.trace
*.dump
adb*.log
logcat*.txt
bugreport*.zip
# Personal media are local build inputs, never public source.
app/src/main/assets/wallpapers/*
!app/src/main/assets/wallpapers/catalog.json
!app/src/main/assets/wallpapers/README.md
!app/src/main/assets/wallpapers/UNSPLASH-NOTICE.txt
# Only the five explicitly selected, source-verified photos are public assets.
!app/src/main/assets/wallpapers/bundled/

# Companion pairing material must stay outside source control.
tv-pairing*.txt
companion-state/
.guizang-tv/
companion-home/
companion-private/
